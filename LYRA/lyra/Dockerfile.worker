# NOT currently used by the live Railway deployment. railway.toml drives the real
# worker build/deploy via Nixpacks (buildCommand = "npm install", startCommand =
# "npx tsx workers/index.ts"), running tsx directly against source -- it has no
# `builder = "DOCKERFILE"` directive, so Railway never builds or runs this image.
# This file is kept for a possible future move to a compiled Docker deploy, but
# does not reflect production reality until railway.toml is repointed at it.
FROM node:22-alpine AS base
WORKDIR /app

# Install deps
FROM base AS deps
COPY package*.json ./
RUN npm ci --omit=dev

# Build — compile TypeScript worker files
FROM base AS builder
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx prisma generate
RUN npx tsc --project tsconfig.workers.json
# tsc leaves "@/..." imports untouched (they're a compile-time-only path mapping) --
# tsc-alias rewrites them to relative paths in the emitted dist/ output so plain
# `node` can resolve them at runtime. Without this, the compiled worker throws
# MODULE_NOT_FOUND on every "@/..." import as soon as it starts.
RUN npx tsc-alias --project tsconfig.workers.json

# Production image
FROM base AS runner
ENV NODE_ENV=production

COPY --from=deps    /app/node_modules ./node_modules
COPY --from=builder /app/dist/workers ./workers
COPY --from=builder /app/dist/services ./services
COPY --from=builder /app/dist/lib ./lib
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY prisma ./prisma

# node:alpine ships a non-root "node" user (uid 1000) out of the box -- no
# root process needed for a BullMQ consumer with no privileged operations.
USER node

# Run all workers via the index entry point
CMD ["node", "workers/index.js"]
