# ─────────────────────────────────────────────
# LYRA — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# Database — Supabase Postgres
DATABASE_URL=
DIRECT_URL=

# Auth0 (v4 — @auth0/nextjs-auth0)
# AUTH0_DOMAIN: your-tenant.auth0.com (no https://)
# Callback URL to register in Auth0 dashboard: http://localhost:3000/auth/callback
# Logout URL to register: http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# MCP OAuth layer (see docs/LYRA-mcp-server-design.md)
AUTH0_MCP_AUDIENCE=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Optional — SDK infers from request if omitted
APP_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=
STRIPE_CRISIS_AWARE_PRICE_ID=
STRIPE_CRISIS_AWARE_ANNUAL_PRICE_ID=
# LYRA Trend checkout is currently disabled (no functional backend yet) --
# these aren't read at runtime, but are here for when it ships.
STRIPE_TREND_PRICE_ID=
STRIPE_TREND_ANNUAL_PRICE_ID=

# Anthropic — Claude API
ANTHROPIC_API_KEY=

# AWS S3 (S3_* names, not AWS_* — see lib/s3.ts comment: AWS_* is reserved by Netlify's
# Lambda runtime and silently picks up the wrong credentials instead of throwing)
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Redis (BullMQ — app + workers)
REDIS_URL=

# Social Platform OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Token Encryption (AES-256-GCM) — used for SocialAccount/SeoConnection/EmailIntegration
# tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change once accounts have been connected -- makes all stored tokens unreadable.
ENCRYPTION_KEY=

# Resend — transactional email (Crisis Aware alerts)
# Get your key at: https://resend.com → API Keys
RESEND_API_KEY=

# Bearer token shared between the cron trigger (external cron-job.org account, or the
# in-repo GitHub Actions backstop in .github/workflows/crons.yml) and every /api/cron/*
# route. Any strong random string. Not needed for local dev.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=

# PDF Generation (for /api/help/pdf)
# Local dev: leave blank to auto-detect Chrome, or set to your Chrome path
# CHROME_EXECUTABLE_PATH=
# Production (Netlify): the Chromium binary is downloaded at runtime — no local binary needed
